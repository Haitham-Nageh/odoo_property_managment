<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_recurring_maintenance_list" model="ir.ui.view">
        <field name="name">edara.recurring.maintenance.list</field>
        <field name="model">edara.recurring.maintenance</field>
        <field name="arch" type="xml">
            <list string="Recurring Maintenance" decoration-muted="not active">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="vendor_id"/>
                <field name="frequency"/>
                <field name="next_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_edara_recurring_maintenance_search" model="ir.ui.view">
        <field name="name">edara.recurring.maintenance.search</field>
        <field name="model">edara.recurring.maintenance</field>
        <field name="arch" type="xml">
            <search string="Recurring Maintenance">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="vendor_id"/>
                <field name="branch_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Due" name="due" domain="[('next_date', '&lt;=', context_today())]"/>
                <group>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Vendor" name="group_by_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Frequency" name="group_by_frequency" context="{'group_by': 'frequency'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_edara_recurring_maintenance_form" model="ir.ui.view">
        <field name="name">edara.recurring.maintenance.form</field>
        <field name="model">edara.recurring.maintenance</field>
        <field name="arch" type="xml">
            <form string="Recurring Maintenance">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_generated_requests" class="oe_stat_button" icon="fa-wrench">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="generated_request_count"/></span>
                                <span class="o_stat_text">Generated Requests</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Elevator Servicing"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="unit_id"/>
                            <field name="building_id" readonly="1" groups="base.group_no_one"/>
                            <field name="property_id" readonly="1" groups="base.group_no_one"/>
                            <field name="category"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="next_date"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this recurring maintenance covers..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_recurring_maintenance" model="ir.actions.act_window">
        <field name="name">Recurring Maintenance</field>
        <field name="res_model">edara.recurring.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edara_recurring_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Define your first recurring maintenance schedule
            </p>
        </field>
    </record>
</odoo>
