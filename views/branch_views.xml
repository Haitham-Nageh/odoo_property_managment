<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_branch_list" model="ir.ui.view">
        <field name="name">edara.branch.list</field>
        <field name="model">edara.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manager_id"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="view_edara_branch_form" model="ir.ui.view">
        <field name="name">edara.branch.form</field>
        <field name="model">edara.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_properties" class="oe_stat_button" icon="fa-building-o">
                            <field name="property_count" widget="statinfo" string="Properties"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ramallah Branch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="manager_id"/>
                            <field name="active" invisible="1"/>
                            <field name="has_accounting_access" invisible="1"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Staff" name="staff">
                            <field name="user_ids"/>
                        </page>
                        <page string="Maintenance SLA" name="maintenance_sla">
                            <group>
                                <field name="sla_response_hours"/>
                                <field name="sla_resolution_hours"/>
                            </group>
                        </page>
                        <page string="Financial Summary" name="financials" invisible="not has_accounting_access">
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="total_revenue"/>
                                <field name="total_expenses"/>
                                <field name="net_operating_result"/>
                                <field name="total_outstanding"/>
                                <field name="maintenance_cost"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">edara.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first branch
            </p>
            <p>
                Branches represent your operational regions or offices (e.g. Ramallah, Nablus).
                They scope staff access and reporting - they are not separate legal companies.
            </p>
        </field>
    </record>
</odoo>
