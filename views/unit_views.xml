<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_unit_list" model="ir.ui.view">
        <field name="name">edara.unit.list</field>
        <field name="model">edara.unit</field>
        <field name="arch" type="xml">
            <list string="Units"
                  decoration-success="occupancy_status == 'available'"
                  decoration-danger="occupancy_status == 'rented'"
                  decoration-warning="occupancy_status == 'reserved'"
                  decoration-muted="operational_status == 'under_maintenance'">
                <field name="name"/>
                <field name="building_id"/>
                <field name="property_id" groups="base.group_no_one"/>
                <field name="unit_type"/>
                <field name="floor"/>
                <field name="area"/>
                <field name="rent_amount_default"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="occupancy_status"/>
                <field name="operational_status"/>
                <field name="active_tenant_name" string="Tenant"/>
            </list>
        </field>
    </record>

    <record id="view_edara_unit_kanban" model="ir.ui.view">
        <field name="name">edara.unit.kanban</field>
        <field name="model">edara.unit</field>
        <field name="arch" type="xml">
            <!--
                Dashboard UX Hardening 6.1 (2026-09-23): the original
                default_group_by="floor" grouping (spec §48) produced
                meaningless "None (17) / 1 (1)" columns in real data (floor
                is a free-text Char, almost never populated) and implicit
                drag-and-drop between them would silently rewrite a unit's
                floor. A Unit is a record, not a workflow stage - it must
                never be draggable. No grouping by default (records_draggable
                is irrelevant without groups, but set false anyway as
                defense-in-depth per the ticket's explicit "no meaningless
                drag" requirement, and matches records_draggable="false"
                already being the right setting for a non-stage model). The
                card itself now surfaces the real information a manager scans
                for: building/floor, occupancy + operational state as
                colored badges, and (only when present) the active tenant
                and lease reference - all read from fields that already
                exist on the model (occupancy_status/operational_status
                directly, active_tenant_name/active_contract_name a thin
                read-only projection of lease_contract_ids, not new data).
            -->
            <kanban class="o_kanban_small_column" records_draggable="false">
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><field name="name"/></strong>
                                <span t-attf-class="badge #{record.operational_status.raw_value == 'under_maintenance' ? 'text-bg-warning' : (record.occupancy_status.raw_value == 'rented' ? 'text-bg-danger' : (record.occupancy_status.raw_value == 'available' ? 'text-bg-success' : 'text-bg-secondary'))}">
                                    <field name="occupancy_status"/>
                                </span>
                            </div>
                            <div class="text-muted small">
                                <field name="building_id"/>
                                <span t-if="record.floor.raw_value"> - Floor <field name="floor"/></span>
                            </div>
                            <div t-if="record.active_tenant_name.raw_value" class="small mt-1">
                                <i class="fa fa-user-o me-1" title="Tenant"/><field name="active_tenant_name"/>
                                <span t-if="record.active_contract_name.raw_value" class="text-muted"> (<field name="active_contract_name"/>)</span>
                            </div>
                            <span t-if="record.operational_status.raw_value == 'under_maintenance'"
                                  class="badge text-bg-warning mt-1">
                                <field name="operational_status"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edara_unit_search" model="ir.ui.view">
        <field name="name">edara.unit.search</field>
        <field name="model">edara.unit</field>
        <field name="arch" type="xml">
            <search string="Units">
                <field name="name"/>
                <field name="building_id"/>
                <field name="floor"/>
                <filter string="Available" name="available" domain="[('occupancy_status', '=', 'available')]"/>
                <filter string="Rented" name="rented" domain="[('occupancy_status', '=', 'rented')]"/>
                <filter string="Under Maintenance" name="under_maintenance"
                        domain="[('operational_status', '=', 'under_maintenance')]"/>
                <group>
                    <filter string="Building" name="group_by_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Floor" name="group_by_floor" context="{'group_by': 'floor'}"/>
                    <filter string="Occupancy" name="group_by_occupancy" context="{'group_by': 'occupancy_status'}"/>
                </group>
                <!--
                    Dashboard UX Hardening 6.1 (2026-09-23): native, zero-JS
                    quick-action equivalent living directly on the Units page
                    itself (not just the Dashboard) - an always-visible,
                    counted category list, click to filter the SAME list/
                    kanban already open (no new page, no new action, no
                    duplicated view). enable_counters computes each count
                    with one read_group per category, not a query per row.
                -->
                <searchpanel>
                    <field name="occupancy_status" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_edara_unit_form" model="ir.ui.view">
        <field name="name">edara.unit.form</field>
        <field name="model">edara.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_contracts" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button type="object" name="action_view_maintenance_requests" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_request_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. A-101"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="building_id"/>
                            <field name="property_id" readonly="1" groups="base.group_no_one"/>
                            <field name="branch_id" readonly="1" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                            <field name="unit_type"/>
                            <field name="floor"/>
                            <field name="unit_number"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="rent_amount_default"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="occupancy_status"/>
                        </group>
                        <group>
                            <field name="operational_status"/>
                        </group>
                    </group>
                    <field name="has_accounting_access" invisible="1"/>
                    <notebook>
                        <page string="Financial Summary" name="financials" invisible="not has_accounting_access">
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="total_revenue"/>
                                <field name="total_expenses"/>
                                <field name="total_outstanding"/>
                                <field name="maintenance_cost"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">edara.unit</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_edara_unit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first unit
            </p>
        </field>
    </record>
</odoo>
