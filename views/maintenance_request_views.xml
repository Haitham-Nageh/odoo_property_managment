<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_maintenance_request_list" model="ir.ui.view">
        <field name="name">edara.maintenance.request.list</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests" decoration-danger="priority == 'urgent'"
                  decoration-muted="state in ('done', 'cancelled')">
                <field name="name"/>
                <field name="title"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="vendor_id"/>
                <field name="priority" widget="badge"/>
                <field name="assigned_user_id"/>
                <field name="requested_date"/>
                <field name="sla_state" widget="badge"
                       decoration-success="sla_state == 'within'"
                       decoration-warning="sla_state == 'at_risk'"
                       decoration-danger="sla_state == 'breached'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!--
        Reporting & Management Intelligence Expansion (2026-09-22): shared by
        the main Maintenance action and the new Maintenance Cost report.
    -->
    <record id="view_edara_maintenance_request_search" model="ir.ui.view">
        <field name="name">edara.maintenance.request.search</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <search string="Maintenance Requests">
                <field name="title"/>
                <field name="vendor_id"/>
                <field name="branch_id"/>
                <field name="property_id"/>
                <field name="category"/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="With Vendor Bill" name="has_bill" domain="[('vendor_bill_id', '!=', False)]"/>
                <filter string="Without Vendor Bill" name="no_bill" domain="[('vendor_bill_id', '=', False)]"/>
                <separator/>
                <filter string="Recurring-Generated" name="recurring" domain="[('edara_recurring_id', '!=', False)]"/>
                <group>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Vendor" name="group_by_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_edara_maintenance_request_kanban" model="ir.ui.view">
        <field name="name">edara.maintenance.request.kanban</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <field name="title" class="fw-bold"/>
                        <div class="text-muted"><field name="unit_id"/></div>
                        <div t-if="record.vendor_id.value" class="text-muted"><field name="vendor_id"/></div>
                        <footer class="pt-1">
                            <field name="priority" widget="badge"/>
                            <field name="sla_state" widget="badge"
                                   decoration-success="sla_state == 'within'"
                                   decoration-warning="sla_state == 'at_risk'"
                                   decoration-danger="sla_state == 'breached'"/>
                            <div class="d-flex ms-auto">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edara_maintenance_request_form" model="ir.ui.view">
        <field name="name">edara.maintenance.request.form</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button string="Assign" type="object" name="action_assign" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button string="Start" type="object" name="action_start" class="btn-primary"
                            invisible="state not in ('new', 'assigned')"/>
                    <button string="Complete" type="object" name="action_complete" class="btn-primary"
                            invisible="state not in ('assigned', 'in_progress')"/>
                    <button string="Cancel" type="object" name="action_cancel"
                            invisible="state in ('done', 'cancelled')" confirm="Cancel this maintenance request?"/>
                    <button string="Create Vendor Bill" type="object" name="action_create_vendor_bill"
                            invisible="cost &lt;= 0 or vendor_bill_id"
                            confirm="Create a draft vendor bill for this maintenance cost?"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_vendor_bill" class="oe_stat_button" icon="fa-money"
                                invisible="not vendor_bill_id or not has_accounting_access">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Vendor Bill</span>
                            </div>
                        </button>
                    </div>
                    <field name="has_accounting_access" invisible="1"/>
                    <widget name="web_ribbon" title="Recurring" bg_color="text-bg-info" invisible="not edara_recurring_id"/>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="e.g. Leaking kitchen faucet"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="unit_id"/>
                            <field name="building_id" readonly="1" groups="base.group_no_one"/>
                            <field name="property_id" readonly="1" groups="base.group_no_one"/>
                            <field name="tenant_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                            <field name="requested_date"/>
                            <field name="completed_date" invisible="not completed_date"/>
                            <field name="edara_recurring_id" readonly="1" invisible="not edara_recurring_id"/>
                        </group>
                    </group>
                    <group string="Cost">
                        <field name="currency_id" invisible="1"/>
                        <field name="vendor_id"/>
                        <field name="cost"/>
                    </group>
                    <group string="SLA">
                        <group>
                            <field name="sla_state" widget="badge"
                                   decoration-success="sla_state == 'within'"
                                   decoration-warning="sla_state == 'at_risk'"
                                   decoration-danger="sla_state == 'breached'"/>
                            <field name="sla_response_target_hours"/>
                            <field name="sla_resolution_target_hours"/>
                        </group>
                        <group>
                            <field name="first_response_at" invisible="not first_response_at"/>
                            <field name="resolved_at" invisible="not resolved_at"/>
                            <field name="response_hours" invisible="not first_response_at"/>
                            <field name="resolution_hours" invisible="not resolved_at"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the issue..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">edara.maintenance.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_edara_maintenance_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first maintenance request
            </p>
        </field>
    </record>
</odoo>
