<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_maintenance_request_list" model="ir.ui.view">
        <field name="name">edara.maintenance.request.list</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests" decoration-danger="priority == 'urgent'"
                  decoration-muted="state in ('done', 'cancelled')">
                <field name="name"/>
                <field name="title"/>
                <field name="unit_id"/>
                <field name="priority" widget="badge"/>
                <field name="assigned_user_id"/>
                <field name="requested_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_edara_maintenance_request_kanban" model="ir.ui.view">
        <field name="name">edara.maintenance.request.kanban</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <field name="title" class="fw-bold"/>
                        <div class="text-muted"><field name="unit_id"/></div>
                        <footer class="pt-1">
                            <field name="priority" widget="badge"/>
                            <div class="d-flex ms-auto">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edara_maintenance_request_form" model="ir.ui.view">
        <field name="name">edara.maintenance.request.form</field>
        <field name="model">edara.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button string="Start" type="object" name="action_start" class="btn-primary"
                            invisible="state not in ('new', 'assigned')"/>
                    <button string="Complete" type="object" name="action_complete" class="btn-primary"
                            invisible="state not in ('assigned', 'in_progress')"/>
                    <button string="Cancel" type="object" name="action_cancel"
                            invisible="state in ('done', 'cancelled')" confirm="Cancel this maintenance request?"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="e.g. Leaking kitchen faucet"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="unit_id"/>
                            <field name="building_id" readonly="1" groups="base.group_no_one"/>
                            <field name="property_id" readonly="1" groups="base.group_no_one"/>
                            <field name="tenant_id"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                            <field name="requested_date"/>
                            <field name="completed_date" invisible="not completed_date"/>
                        </group>
                    </group>
                    <group string="Cost">
                        <field name="currency_id" invisible="1"/>
                        <field name="vendor_id"/>
                        <field name="cost"/>
                    </group>
                    <field name="description" placeholder="Describe the issue..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">edara.maintenance.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first maintenance request
            </p>
        </field>
    </record>
</odoo>
