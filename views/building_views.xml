<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_building_list" model="ir.ui.view">
        <field name="name">edara.building.list</field>
        <field name="model">edara.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="name"/>
                <field name="code"/>
                <field name="property_id"/>
                <field name="branch_id" groups="base.group_no_one"/>
                <field name="floor_count"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="view_edara_building_form" model="ir.ui.view">
        <field name="name">edara.building.form</field>
        <field name="model">edara.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_units" class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                        <button type="object" name="action_view_service_charges" class="oe_stat_button" icon="fa-bolt">
                            <field name="service_charge_count" widget="statinfo" string="Service Charges"/>
                        </button>
                        <button type="object" name="action_view_contracts" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button type="object" name="action_view_maintenance_requests" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_request_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Building A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="property_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="floor_count"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">edara.building</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first building
            </p>
        </field>
    </record>
</odoo>
