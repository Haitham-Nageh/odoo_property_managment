<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_unit_type_list" model="ir.ui.view">
        <field name="name">edara.unit.type.list</field>
        <field name="model">edara.unit.type</field>
        <field name="arch" type="xml">
            <list string="Unit Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="has_bedrooms_bathrooms"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_edara_unit_type_form" model="ir.ui.view">
        <field name="name">edara.unit.type.form</field>
        <field name="model">edara.unit.type</field>
        <field name="arch" type="xml">
            <form string="Unit Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="has_bedrooms_bathrooms"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edara_unit_type_search" model="ir.ui.view">
        <field name="name">edara.unit.type.search</field>
        <field name="model">edara.unit.type</field>
        <field name="arch" type="xml">
            <search string="Unit Types">
                <field name="name"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_edara_unit_type" model="ir.actions.act_window">
        <field name="name">Unit Types</field>
        <field name="res_model">edara.unit.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edara_unit_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first unit type
            </p>
        </field>
    </record>
</odoo>
