<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_payment_schedule_line_list" model="ir.ui.view">
        <field name="name">edara.payment.schedule.line.list</field>
        <field name="model">edara.payment.schedule.line</field>
        <field name="arch" type="xml">
            <list string="Payment Schedule" editable="bottom" create="0"
                  decoration-danger="state == 'overdue'" decoration-success="state == 'paid'">
                <field name="sequence" widget="handle"/>
                <field name="contract_id" column_invisible="1"/>
                <field name="due_date"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_edara_payment_schedule_line_form" model="ir.ui.view">
        <field name="name">edara.payment.schedule.line.form</field>
        <field name="model">edara.payment.schedule.line</field>
        <field name="arch" type="xml">
            <form string="Payment Schedule Line">
                <header>
                    <button string="Charge Late Fee" type="object" name="action_charge_late_fee"
                            class="btn-secondary" invisible="state != 'overdue'"
                            confirm="Charge the configured late fee amount as a separate invoice for this overdue payment?"/>
                </header>
                <sheet>
                    <group>
                        <field name="contract_id" readonly="1"/>
                        <field name="due_date"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="description"/>
                        <field name="invoice_id" readonly="1"/>
                        <field name="state" widget="badge"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edara_payment_schedule_line" model="ir.actions.act_window">
        <field name="name">Payment Schedule</field>
        <field name="res_model">edara.payment.schedule.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No payment schedule lines yet
            </p>
            <p>
                Schedule lines are generated automatically when a lease contract
                is activated, based on its billing frequency and payment day.
            </p>
        </field>
    </record>
</odoo>
