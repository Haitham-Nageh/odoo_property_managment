<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.edara</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="EDARA Property Management" string="EDARA Property Management"
                     name="property_managment" groups="property_managment.group_edara_company_manager">
                    <block title="Accounting" name="edara_accounting_setting_container">
                        <setting id="edara_rental_income_account_setting"
                                 help="Account credited when a rent invoice is posted.">
                            <field name="edara_rental_income_account_id"/>
                        </setting>
                        <setting id="edara_late_fee_income_account_setting"
                                 help="Account credited when a late fee invoice is posted.">
                            <field name="edara_late_fee_income_account_id"/>
                        </setting>
                        <setting id="edara_late_fee_amount_setting"
                                 help="Flat amount charged when staff manually charge a late fee on an overdue payment. Never applied automatically.">
                            <field name="edara_late_fee_amount"/>
                        </setting>
                        <setting id="edara_service_charge_income_account_setting"
                                 help="Account credited when a service charge invoice is posted.">
                            <field name="edara_service_charge_income_account_id"/>
                        </setting>
                        <setting id="edara_deposit_liability_account_setting"
                                 help="Liability account holding tenant security deposits.">
                            <field name="edara_deposit_liability_account_id"/>
                        </setting>
                        <setting id="edara_deposit_deduction_income_account_setting"
                                 help="Income account credited when a deposit deduction (e.g. damage recovery) is recorded.">
                            <field name="edara_deposit_deduction_income_account_id"/>
                        </setting>
                        <setting id="edara_maintenance_expense_account_setting"
                                 help="Expense account debited when a maintenance vendor bill is created.">
                            <field name="edara_maintenance_expense_account_id"/>
                        </setting>
                    </block>
                    <block title="Maintenance SLA" name="edara_maintenance_sla_setting_container">
                        <setting id="edara_sla_response_enabled_setting"
                                 help="Enable response SLA tracking for maintenance requests by default for this company. Disabled by default. Enabling response SLA does not enable resolution SLA. The 80% at-risk threshold is fixed in this release.">
                            <field name="edara_sla_response_enabled"/>
                        </setting>
                        <setting id="edara_sla_response_hours_setting"
                                 help="Default target time in hours from request creation until the first qualifying staff action. 24 hours is a suggested value only. Applies when Response SLA is enabled.">
                            <field name="edara_sla_response_hours"/>
                        </setting>
                        <setting id="edara_sla_resolution_enabled_setting"
                                 help="Enable resolution SLA tracking for maintenance requests by default for this company. Disabled by default. Enabling resolution SLA does not enable response SLA. The 80% at-risk threshold is fixed in this release.">
                            <field name="edara_sla_resolution_enabled"/>
                        </setting>
                        <setting id="edara_sla_resolution_hours_setting"
                                 help="Default target time in hours from request creation until final completion. 72 hours is a suggested value only. Applies when Resolution SLA is enabled.">
                            <field name="edara_sla_resolution_hours"/>
                        </setting>
                        <setting id="edara_sla_notifications_enabled_setting"
                                 help="Enable automated notifications when maintenance SLA targets approach or breach. Enabled by default and controlled independently from target activation.">
                            <field name="edara_sla_notifications_enabled"/>
                        </setting>
                    </block>
                    <block title="Portal Access" name="edara_portal_setting_container">
                        <setting id="edara_portal_grace_days_setting"
                                 help="Number of days tenant retains portal access after contract ends or obligations are settled. Default is 30 days.">
                            <field name="edara_portal_grace_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_edara_config_settings" model="ir.actions.act_window">
        <field name="name">EDARA Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'property_managment'}</field>
    </record>
</odoo>
