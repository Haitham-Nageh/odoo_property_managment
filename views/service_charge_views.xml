<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_service_charge_list" model="ir.ui.view">
        <field name="name">edara.service.charge.list</field>
        <field name="model">edara.service.charge</field>
        <field name="arch" type="xml">
            <list string="Service Charges">
                <field name="name"/>
                <field name="building_id"/>
                <field name="date"/>
                <field name="allocation_method"/>
                <field name="total_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_edara_service_charge_form" model="ir.ui.view">
        <field name="name">edara.service.charge.form</field>
        <field name="model">edara.service.charge</field>
        <field name="arch" type="xml">
            <form string="Service Charge">
                <header>
                    <button string="Generate Allocation" type="object" name="action_generate_allocation"
                            class="btn-primary" invisible="state == 'invoiced'"/>
                    <button string="Create Invoices" type="object" name="action_invoice_lines"
                            invisible="state != 'allocated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,allocated,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="building_id" readonly="state != 'draft'"/>
                            <field name="branch_id" readonly="1" groups="base.group_no_one"/>
                            <field name="property_id" readonly="1" groups="base.group_no_one"/>
                            <field name="date"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="allocation_method" readonly="state != 'draft'"/>
                            <field name="total_amount"
                                   invisible="allocation_method not in ('equal', 'proportional')"/>
                            <field name="rate_per_sqm" invisible="allocation_method != 'per_sqm'"/>
                            <field name="fixed_amount_per_unit" invisible="allocation_method != 'fixed_per_unit'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocation" name="allocation">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="unit_id"/>
                                    <field name="tenant_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="invoice_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edara_service_charge" model="ir.actions.act_window">
        <field name="name">Service Charges</field>
        <field name="res_model">edara.service.charge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first service charge
            </p>
        </field>
    </record>
</odoo>
