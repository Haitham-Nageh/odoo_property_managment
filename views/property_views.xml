<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edara_property_list" model="ir.ui.view">
        <field name="name">edara.property.list</field>
        <field name="model">edara.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="building_count"/>
                <field name="unit_count"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="view_edara_property_form" model="ir.ui.view">
        <field name="name">edara.property.form</field>
        <field name="model">edara.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_buildings" class="oe_stat_button" icon="fa-building">
                            <field name="building_count" widget="statinfo" string="Buildings"/>
                        </button>
                        <button type="object" name="action_view_units" class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                        <button type="object" name="action_view_expenses" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Expenses</span>
                            </div>
                        </button>
                        <button type="object" name="action_view_invoices" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Al-Irsal Complex"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ownership" name="ownership">
                            <field name="ownership_ids">
                                <list editable="bottom">
                                    <field name="owner_id"/>
                                    <field name="ownership_percentage"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </list>
                            </field>
                        </page>
                        <page string="Buildings" name="buildings">
                            <field name="building_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="floor_count"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Financial Summary" name="financials">
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="total_revenue"/>
                                <field name="total_expenses"/>
                                <field name="net_operating_result"/>
                                <field name="total_outstanding"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edara_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">edara.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first property
            </p>
            <p>
                A Property is the ownership and financial boundary - e.g. a complex or a
                single building under one ownership structure.
            </p>
        </field>
    </record>
</odoo>
