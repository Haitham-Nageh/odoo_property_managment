<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_edara_generate_due_invoices" model="ir.cron">
        <field name="name">EDARA: Generate due rent invoices</field>
        <field name="model_id" ref="model_edara_payment_schedule_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_due_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_edara_expire_contracts" model="ir.cron">
        <field name="name">EDARA: Expire lease contracts past their end date</field>
        <field name="model_id" ref="model_edara_lease_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
