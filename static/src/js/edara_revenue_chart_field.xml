<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="property_managment.EdaraRevenueTrendChartField">
        <div class="o_edara_revenue_trend_widget w-100">
            <!-- Header with Title and Currency Indicator -->
            <div class="o_edara_revenue_trend_header d-flex align-items-center justify-content-between mb-3 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="oi text-success fs-5" data-icon="bar_chart"/>
                    <span class="fw-bold fs-6 text-dark">
                        <t t-if="this.chartData.period === 'yearly'">Revenue Trend (Trailing 5 Years)</t>
                        <t t-else="">Revenue Trend (Trailing 6 Months)</t>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border px-2 py-1">
                        <i class="oi me-1" data-icon="payments"/>
                        <t t-esc="this.chartData.currency || this.currencyFallback"/>
                    </span>
                </div>
            </div>

            <!-- Zero / Empty State -->
            <t t-if="this.isAllZero">
                <div class="o_edara_chart_empty_state text-center py-4 text-muted">
                    <i class="oi oi-3x mb-2 text-muted opacity-50" data-icon="bar_chart"/>
                    <div class="fw-semibold">
                        <t t-if="this.chartData.period === 'yearly'">No revenue in trailing 5 years</t>
                        <t t-else="">No revenue in trailing 6 months</t>
                    </div>
                    <div class="small text-muted">Revenue trend will appear once customer invoices are posted.</div>
                </div>
            </t>

            <!-- Chart Canvas -->
            <t t-else="">
                <div class="o_edara_revenue_chart_canvas_wrapper position-relative">
                    <canvas t-ref="this.canvasRef"/>
                </div>
            </t>
        </div>
    </t>
</templates>
