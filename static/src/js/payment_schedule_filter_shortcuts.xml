<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Ticket U1 / Phase 6.6: MUST be t-inherit-mode="primary". "extension" mode
         patches the shared web.ListView template in place, affecting every list
         view in the backend regardless of js_class - "primary" instead creates
         this as an independent template that only this controller opts into. -->
    <t t-name="property_managment.PaymentScheduleFilterShortcutsListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="before">
            <div class="o_edara_schedule_filter_shortcuts" t-if="this.edaraFilterShortcuts.length" role="toolbar" aria-label="Status Filters">
                <button t-foreach="this.edaraFilterShortcuts" t-as="item" t-key="item.id"
                        type="button"
                        t-att-aria-pressed="item.isActive ? 'true' : 'false'"
                        t-attf-class="btn btn-sm o_edara_schedule_filter_shortcut o_edara_shortcut_{{ item.name }} {{ item.isActive ? ('btn-' + item.color + ' is-active') : ('btn-outline-' + item.color) }}"
                        t-on-click="() => this.onEdaraFilterShortcutClick(item.id)">
                    <span class="o_edara_schedule_filter_shortcut_label" t-esc="item.description"/>
                    <span class="o_edara_schedule_filter_shortcut_count" t-esc="item.count"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
