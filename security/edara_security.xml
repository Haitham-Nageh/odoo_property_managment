<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_edara" model="ir.module.category">
        <field name="name">EDARA Property Management</field>
        <field name="sequence">20</field>
    </record>

    <!--
        Odoo 19 replaced res.groups.category_id with res.groups.privilege_id:
        a "privilege" is a named selection axis (rendered as one dropdown/checkbox
        in Settings > Users) grouping together the mutually-related groups of a
        category. See odoo/addons/base/models/res_groups_privilege.py.

        "Access Level" is the main ladder (each level implies the previous one,
        so picking one automatically grants everything below it). Maintenance
        and Accounting are independent add-on privileges - each is a single
        toggle on top of whatever access level a user already has.
    -->
    <record id="privilege_edara_access_level" model="res.groups.privilege">
        <field name="name">Access Level</field>
        <field name="category_id" ref="module_category_edara"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_edara_maintenance" model="res.groups.privilege">
        <field name="name">Maintenance</field>
        <field name="category_id" ref="module_category_edara"/>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_edara_accounting" model="res.groups.privilege">
        <field name="name">Accounting</field>
        <field name="category_id" ref="module_category_edara"/>
        <field name="sequence">30</field>
    </record>

    <!-- Baseline: read access to branch-scoped operational data -->
    <record id="group_edara_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_edara_access_level"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to properties, units, contracts and tenants within assigned branches.</field>
    </record>

    <record id="group_edara_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="privilege_id" ref="privilege_edara_access_level"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_edara_viewer'))]"/>
        <field name="comment">Operational management (properties, units, contracts, tenants) within assigned branches; can record payments but not access journals directly.</field>
    </record>

    <record id="group_edara_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="privilege_id" ref="privilege_edara_access_level"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_edara_property_manager'))]"/>
        <field name="comment">Full operational control of assigned branches.</field>
    </record>

    <record id="group_edara_maintenance" model="res.groups">
        <field name="name">Maintenance Staff</field>
        <field name="privilege_id" ref="privilege_edara_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('group_edara_viewer'))]"/>
        <field name="comment">Can manage maintenance requests assigned to them within their branches.</field>
    </record>

    <record id="group_edara_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_edara_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_edara_viewer'))]"/>
        <field name="comment">Full financial access (invoices, payments, deposits) within assigned branches; operational data is read-only.</field>
    </record>

    <record id="group_edara_company_manager" model="res.groups">
        <field name="name">Company Manager</field>
        <field name="privilege_id" ref="privilege_edara_access_level"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_edara_branch_manager')), (4, ref('group_edara_accountant'))]"/>
        <field name="comment">Full access across all branches of the company.</field>
    </record>

    <record id="group_edara_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_edara_access_level"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('group_edara_company_manager'))]"/>
        <field name="comment">Full technical and functional access to EDARA, including configuration.</field>
        <!-- Same pattern native apps use (e.g. account.group_account_manager) so the
             app is visible in the App Switcher out of the box for the instance admin,
             instead of being invisible to everyone until someone manually assigns a group. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- Portal: tenants accessing their own lease/invoices/maintenance through the website portal -->
    <record id="group_edara_portal_tenant" model="res.groups">
        <field name="name">Portal Tenant</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Tenant portal access - restricted to the tenant's own unit, lease, invoices and requests.</field>
    </record>
</odoo>
