<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pattern reused for every branch-scoped EDARA model added in later phases:
        1) a global (no group) multi-company rule: company_id in user's allowed companies
        2) a restrictive rule on group_edara_viewer (inherited by every other EDARA
           role): only branches the user is assigned to (staff or manager)
        3) a full-access rule on group_edara_company_manager: sees every branch of
           the company. Since Company Manager/Administrator also carry
           group_edara_viewer (via implied_ids), rule (2) and (3) are OR'd together
           for them, so the company-wide rule wins.
    -->
    <record id="rule_edara_branch_company" model="ir.rule">
        <field name="name">EDARA Branch: multi-company</field>
        <field name="model_id" ref="model_edara_branch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_edara_branch_assigned_only" model="ir.rule">
        <field name="name">EDARA Branch: assigned branches only</field>
        <field name="model_id" ref="model_edara_branch"/>
        <field name="domain_force">['|', ('user_ids', 'in', [user.id]), ('manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_edara_viewer'))]"/>
    </record>

    <record id="rule_edara_branch_company_manager_all" model="ir.rule">
        <field name="name">EDARA Branch: company manager sees all branches</field>
        <field name="model_id" ref="model_edara_branch"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_edara_company_manager'))]"/>
    </record>

