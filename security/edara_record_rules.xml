    <!--
        Portal tenant access: a tenant must only ever see/create their OWN records,
        never another tenant's - never derivable via record id guessing (spec §39).
        These are the only rules that apply to group_edara_portal_tenant (it does not
        carry group_edara_viewer), so each is the complete restriction for that group.
    -->
    <record id="rule_edara_lease_contract_portal_own" model="ir.rule">
        <field name="name">EDARA Lease Contract: portal tenant sees only their own</field>
        <field name="model_id" ref="model_edara_lease_contract"/>
        <field name="domain_force">[('tenant_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_edara_portal_tenant'))]"/>
    </record>
    <record id="rule_edara_unit_portal_own" model="ir.rule">
        <field name="name">EDARA Unit: portal tenant sees only their leased unit(s)</field>
        <field name="model_id" ref="model_edara_unit"/>
        <field name="domain_force">[('lease_contract_ids.tenant_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_edara_portal_tenant'))]"/>
    </record>
    <record id="rule_edara_maintenance_request_portal_own" model="ir.rule">
