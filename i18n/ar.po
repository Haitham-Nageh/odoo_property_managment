#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid " (prorated, %(days)s days)"
msgstr " (محتسب نسبياً، %(days)s يوماً)"

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_payment_schedule_line.py:0
msgid "%(amount)s due on %(date)s for %(contract)s is overdue."
msgstr "%(amount)s المستحقة بتاريخ %(date)s لعقد %(contract)s متأخرة."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_renewal_request.py:0
msgid "%(contract)s already has an open renewal request."
msgstr "%(contract)s لديه طلب تجديد مفتوح بالفعل."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid ""
"%(contract)s for %(tenant)s at %(unit)s expires on %(date)s. Review renewal "
"or termination."
msgstr ""
"%(contract)s للمستأجر %(tenant)s في الوحدة %(unit)s ينتهي بتاريخ %(date)s. "
"يرجى مراجعة التجديد أو إنهاء العقد."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_dashboard.py:0
msgid "%(count)d contract(s) expired."
msgstr "%(count)d عقد (عقود) منتهية الصلاحية."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_dashboard.py:0
msgid "%(count)d maintenance request(s) generated."
msgstr "تم إنشاء %(count)d طلب (طلبات) صيانة."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_payment_schedule_line.py:0
msgid ""
"%(charged)d late fee(s) charged, %(skipped_already)d already charged, "
"%(skipped_not_overdue)d not overdue."
msgstr ""
"تم فرض %(charged)d غرامة (غرامات) تأخير، وتم تخطي %(skipped_already)d تم فرضها مسبقاً، "
"و%(skipped_not_overdue)d ليست متأخرة."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_payment_schedule_line.py:0
msgid ""
"%(charged)d late fee(s) charged, %(skipped_already)d already charged, "
"%(skipped_not_overdue)d not overdue, %(errors)d error(s)."
msgstr ""
"تم فرض %(charged)d غرامة (غرامات) تأخير، وتم تخطي %(skipped_already)d تم فرضها مسبقاً، "
"و%(skipped_not_overdue)d ليست متأخرة، وحدث %(errors)d خطأ (أخطاء)."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_dashboard.py:0
msgid ""
"%(created)d invoice(s) created, %(skipped)d skipped, %(errors)d error(s)."
msgstr ""
"تم إنشاء %(created)d فاتورة (فواتير)، وتم تخطي %(skipped)d، وحدث %(errors)d "
"خطأ (أخطاء)."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid "%(name)s already has a renewal (%(succ)s)."
msgstr "%(name)s لديه طلب تجديد بالفعل (%(succ)s)."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_renewal_request.py:0
msgid "%(tenant)s requested to renew %(contract)s. A decision is pending."
msgstr ""
"طلب المستأجر %(tenant)s تجديد العقد %(contract)s. القرار قيد الانتظار."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_maintenance_request.py:0
msgid "%(title)s for %(unit)s has been open since %(date)s."
msgstr "%(title)s للوحدة %(unit)s مفتوح منذ %(date)s."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_maintenance_request.py:0
msgid ""
"%(title)s for %(unit)s: resolution target is %(target).1fh, currently open "
"%(elapsed).1fh."
msgstr ""
"%(title)s للوحدة %(unit)s: وقت المعالجة المستهدف هو %(target).1fh ساعة، وهو "
"مفتوح حالياً منذ %(elapsed).1fh ساعة."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_maintenance_request.py:0
msgid "%(title)s reported for %(unit)s needs triage."
msgstr "%(title)s المبلغ عنه للوحدة %(unit)s يتطلب تقييماً وتحديد أولوية."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid ""
"%(unit)s already has an active lease (%(other)s) overlapping these dates."
msgstr ""
"الوحدة %(unit)s لديها عقد إيجار نشط بالفعل (%(other)s) يتداخل مع هذه "
"التواريخ."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_unit.py:0
msgid ""
"%(unit)s can only be marked Rented through an active lease contract that is "
"currently in force (its start date must have arrived)."
msgstr ""
"لا يمكن تعيين الوحدة %(unit)s كـ 'مؤجّرة' إلا من خلال عقد إيجار نشط ساري "
"المفعول حالياً (يجب أن يكون تاريخ بدايته قد بدأ)."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_unit.py:0
msgid "%(unit)s cannot be Available while it is Under Maintenance."
msgstr "لا يمكن أن تكون الوحدة %(unit)s 'متاحة' طالما أنها 'قيد الصيانة'."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_unit.py:0
msgid ""
"%(unit)s cannot be marked %(status)s while it still has a currently active "
"lease contract covering today. Terminate or end the lease first."
msgstr ""
"لا يمكن تعيين الوحدة %(unit)s بالحالة %(status)s ما دام لديها عقد إيجار نشط "
"حاليًا يشمل تاريخ اليوم. يجب إنهاء عقد الإيجار أو إنهاؤه أولًا."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_unit.py:0
msgid ""
"%(unit)s cannot be marked Available while it has an active lease contract "
"reserved for a future start date - use Reserved instead."
msgstr ""
"لا يمكن تعيين الوحدة %(unit)s كـ 'متاحة' طالما أن لديها عقد إيجار نشط محجوز "
"لتاريخ بدء مستقبلي - استخدم 'محجوز' بدلاً من ذلك."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_unit.py:0
msgid ""
"%(unit)s cannot be marked Available while it still has a currently active "
"lease contract covering today."
msgstr ""
"لا يمكن تعيين الوحدة %(unit)s كـ 'متاحة' طالما أن لديها عقد إيجار نشط حالياً"
" يغطي تاريخ اليوم."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid "%(unit)s has been sold and cannot be leased."
msgstr "تم بيع الوحدة %(unit)s ولا يمكن تأجيرها."

#. module: property_managment
#. odoo-python
#: code:addons/property_managment/models/edara_lease_contract.py:0
msgid "%(unit)s is under maintenance and cannot be leased right now."
msgstr "الوحدة %(unit)s قيد الصيانة ولا يمكن تأجيرها حالياً."

#. module: property_managment
#: model:ir.model.fields,help:property_managment.field_edara_unit__occupancy_status
msgid ""
"'Rented' can only be set through an active lease contract (see the Contracts"
" smart button) - it is not freely editable."
msgstr ""
"حالة 'مؤجّر' يمكن تحديدها فقط عبر عقد إيجار نشط (راجع زر العقود الذكي) - "
"وليست قابلة للتعديل بحرية."

